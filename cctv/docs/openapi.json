{
  "openapi": "3.0.3",
  "info": {
    "title": "CCTV SLM API",
    "version": "0.3.1",
    "description": "API aplikasi CCTV SLM: autentikasi, kamera, invoice dan packing, kejadian, presence, bukti privat, serta aturan push/email/WhatsApp. Kontrak endpoint ERP keluar dijelaskan dalam docs/integrasi-erp-slm.md."
