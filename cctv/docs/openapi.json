    "/api/login": {
      "post": {
        "summary": "Masuk; token berlaku 30 hari",
        "operationId": "post__api_login",
        "security": [],
        "responses": {
          "200": {
            "description": "Berhasil",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "description": "Token tidak valid"
          },
          "403": {
            "description": "Perlu admin"
          },
          "422": {
            "description": "Validasi gagal"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        }
      }
    },
