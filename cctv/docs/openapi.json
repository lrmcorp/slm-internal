        "responses": {
          "200": {
            "description": "Berhasil",
            "content": {
              "application/vnd.apple.mpegurl": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "video/mp2t": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "Token tidak valid"
          },
          "403": {
            "description": "Perlu admin"
          },
          "422": {
            "description": "Validasi gagal"
          },
          "503": {
            "description": "Frame kamera terlalu lama; stream tidak dianggap live."
          }
        },
        "parameters": [
          {
            "name": "camera",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "file",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
