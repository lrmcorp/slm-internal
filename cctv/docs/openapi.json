  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "ingestToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CCTV-Ingest-Token"
      }
    },
    "schemas": {
      "Login": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "Session": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              }
            }
          }
        }
      },
      "Device": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "platform": {
            "type": "string",
            "enum": [
              "android",
              "ios"
            ]
          }
        },
        "required": [
          "token",
          "platform"
        ]
      },
      "PresenceSettings": {
        "type": "object",
        "properties": {
          "absence_seconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 86400
          },
          "presence_alerts_enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "absence_seconds",
          "presence_alerts_enabled"
        ]
      },
      "Classification": {
        "type": "object",
        "properties": {
          "classification": {
            "type": "string",
            "enum": [
              "unclassified",
              "customer",
              "staff",
              "visitor"
            ]
          }
        },
        "required": [
          "classification"
        ]
      },
      "Rule": {
        "type": "object",
        "properties": {
          "incident_type": {
            "type": "string",
            "enum": [
              "anomaly",
              "person_absent",
              "camera_offline",
              "worker_offline"
            ]
          },
          "channel": {
            "type": "string",
            "enum": [
              "push",
              "whatsapp",
              "email"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "whatsapp_number": {
            "type": "string",
            "pattern": "^\\+[1-9][0-9]{7,14}$"
          },
          "user_id": {
            "type": "integer"
          }
        },
        "required": [
          "incident_type",
          "channel",
          "enabled"
        ]
      },
      "Review": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "dismissed"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "status"
        ]
      },
      "LabelReview": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "rejected"
            ]
          },
          "field_one": {
            "type": "string"
          },
          "field_two": {
            "type": "string"
          },
          "field_three": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "CameraCreate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "location": {
            "type": "string"
          },
          "stream_env_key": {
            "type": "string",
            "pattern": "^CCTV_CAMERA_[0-9]+_URL$"
          }
        },
        "required": [
          "name",
          "stream_env_key"
        ]
      },
      "Zones": {
        "type": "object",
        "properties": {
          "zones": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "store_boundary",
                    "box_area",
                    "packing_route",
                    "danger_zone",
                    "packing_area"
                  ]
                },
                "points": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 30,
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                }
              },
              "required": [
                "type",
                "points"
              ]
            }
          }
        },
        "required": [
          "zones"
        ]
      },
      "Page": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "next_page_url": {
            "type": "string",
            "nullable": true
          },
          "current_page": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "Camera": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "location": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string"
          },
          "frame_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "last_seen_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "detector_ready": {
            "type": "boolean"
          },
          "presence_alerts_enabled": {
            "type": "boolean"
          },
          "absence_seconds": {
            "type": "integer"
          }
        }
      },
      "FileUpload": {
        "type": "object",
        "properties": {
          "image": {
            "type": "string",
            "format": "binary"
          }
        },
        "required": [
          "image"
        ]
      },
      "Observation": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "maxLength": 64
          },
          "detector_ready": {
            "type": "boolean"
          },
          "tracks": {
            "type": "string",
            "description": "JSON array of {id:string,box:[x1,y1,x2,y2]}; coordinates 0..1"
          },
          "snapshot": {
            "type": "string",
            "format": "binary"
          },
          "objects": {
            "type": "string",
            "description": "JSON array opsional track objek: [{id,box:[x1,y1,x2,y2]}], maksimal 50; tidak masuk laporan orang."
          }
        },
        "required": [
          "session_id",
          "detector_ready",
          "tracks",
          "snapshot"
        ]
      },
      "Heartbeat": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "online",
              "offline",
              "error"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "LabelIngest": {
        "type": "object",
        "properties": {
          "field_one": {
            "type": "string"
          },
          "field_two": {
            "type": "string"
          },
          "field_three": {
            "type": "string"
          },
          "raw_ocr": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "snapshot": {
            "type": "string",
            "format": "binary"
          }
        },
        "required": [
          "field_one",
          "confidence",
          "observed_at",
          "snapshot"
        ]
      },
      "IncidentIngest": {
        "type": "object",
        "properties": {
          "source_event_id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "anomaly"
            ]
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string"
          },
          "item_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "exited_boundary": {
            "type": "boolean"
          },
          "passed_packing_route": {
            "type": "boolean"
          },
          "snapshot": {
            "type": "string",
            "format": "binary"
          },
          "clip": {
            "type": "string",
            "format": "binary"
          }
        },
        "required": [
          "source_event_id",
          "type",
          "occurred_at",
          "reason",
          "item_count",
          "exited_boundary",
          "passed_packing_route",
          "snapshot"
        ]
      },
      "Clip": {
        "type": "object",
        "properties": {
          "clip": {
            "type": "string",
            "format": "binary"
          }
        },
        "required": [
          "clip"
        ]
      }
    }
  }
}
