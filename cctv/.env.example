# Salin ke .env; isi nilai rahasia hanya pada server Anda. Jangan commit file .env.
# Wajib. Buat dengan: openssl rand -hex 32
CCTV_INGEST_TOKEN=
CCTV_CAMERA_14_URL=rtsp://USER:PASSWORD@100.82.238.124:8554/Streaming/Channels/1401
CCTV_CAMERA_13_URL=rtsp://USER:PASSWORD@100.82.238.124:8554/Streaming/Channels/1301
CCTV_CAMERA_12_URL=rtsp://USER:PASSWORD@100.82.238.124:8554/Streaming/Channels/1201
CCTV_PROCESS_FPS=3
# qr: hanya QR berisi invoice; auto: QR dahulu, lalu OCR bila QR tidak terbaca.
CCTV_LABEL_MODE=auto
CCTV_LABEL_ENABLED=true
# ROI label [x,y,width,height] dalam koordinat 0..1; isi setelah kalibrasi kamera.
# CCTV_LABEL_ROI=[0.1,0.1,0.6,0.4]
SLM_BASE_URL=https://mkr.lrmslm.com
SLM_LOOKUP_PATH=/api/cctv/labels/lookup
SLM_SYNC_PATH=/api/cctv/labels/sync
SLM_SYNC_UPLOAD_PHOTO=true
SLM_API_TOKEN=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_TEMPLATE_NAME=
# Template resmi dengan header gambar dan tiga variabel teks pada body.
WA_IMAGE_TEMPLATE_NAME=
# Integrasi 2 Model AI (Model 1: OpenCV lokal; Model 2: Google Gemini Vision)
CCTV_AI_PROVIDER=gemini
CCTV_AI_MODEL=gemini-3.5-flash-lite
CCTV_AI_API_KEY=

# Video live diproses terpisah dari QR/AI; tidak mengubah sumber bukti.
CCTV_LIVE_USE_SUBSTREAM=true
CCTV_LIVE_FPS=6
CCTV_LIVE_MAX_WIDTH=960
CCTV_OBSERVATION_INTERVAL=5
CCTV_ASYNC_SLM_MATCH=true

# 100% Full Otomatisasi: Auto-Pack Selesai & Auto-Sync ke ERP SLM saat invoice terdeteksi
CCTV_AUTO_SYNC_PACKING=true

# Ringan server: deteksi memakai sub-stream (bukti foto/klip ikut resolusi rendah; uji dulu).
CCTV_DETECT_USE_SUBSTREAM=false
PHP_CLI_SERVER_WORKERS=8
# Alamat bind port web. Jika NPM berjalan di container lain, isi 0.0.0.0 dan batasi 8000 dengan firewall.
CCTV_WEB_BIND=127.0.0.1
# Port di host yang diteruskan ke container web (di dalam container tetap 8000).
CCTV_WEB_PORT=8000
