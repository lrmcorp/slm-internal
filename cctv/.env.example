# Pengaturan stack CCTV. Salin ke cctv/.env di server, lalu isi nilai rahasia HANYA di server.
# File .env, stack.env, dan folder secrets/ tidak pernah di-commit.
# Variabel yang dikosongkan memakai nilai bawaan yang tertulis di komentarnya.

# ---------------------------------------------------------------- Wajib
# Token ingest antara worker vision dan backend. Buat dengan: openssl rand -hex 32
CCTV_INGEST_TOKEN=
# Kunci aplikasi Laravel. Buat sekali dengan: docker compose run --rm web php artisan key:generate --show
APP_KEY=
# Alamat dashboard CCTV. Bawaan: https://cctv.lrmslm.com
APP_URL=https://cctv.lrmslm.com
# Admin dashboard pertama (dibuat sekali bila belum ada; password minimal 12 karakter).
CCTV_ADMIN_EMAIL=
CCTV_ADMIN_PASSWORD=

# ---------------------------------------------------------------- Kamera
# Alamat RTSP kamera. Kamera ada di komputer toko (Tailscale), penerus port 8554.
# Format Hikvision: …/Streaming/Channels/<kanal><01=main|02=sub>. Nama lama CCTV_RTSP_14 dst. tetap dibaca.
CCTV_CAMERA_14_URL=rtsp://USER:PASSWORD@100.118.114.23:8554/Streaming/Channels/1401
CCTV_CAMERA_13_URL=rtsp://USER:PASSWORD@100.118.114.23:8554/Streaming/Channels/1301
CCTV_CAMERA_12_URL=rtsp://USER:PASSWORD@100.118.114.23:8554/Streaming/Channels/1201
# ID kamera di database backend yang dilayani worker vision (1=Camera 14, 2=Camera 13, 3=Camera 12). Bawaan: 1,2,3
CCTV_CAMERA_IDS=1,2,3
# Kamera yang membaca label QR (meja packing). Bawaan: 1
CCTV_LABEL_CAMERA_IDS=1
# qr: hanya QR berisi invoice (bawaan). auto: QR dulu, lalu OCR teks (butuh image dengan CCTV_WITH_TESSERACT=1).
CCTV_LABEL_MODE=qr
# ROI label [x,y,width,height] dalam koordinat 0..1; isi setelah kalibrasi kamera. Kosong = seluruh gambar.
# CCTV_LABEL_ROI=[0.1,0.1,0.6,0.4]

# ---------------------------------------------------------------- Pemrosesan dan hemat RAM
# Frame yang diproses per detik per kamera (sisanya dilewati tanpa diubah jadi gambar). Bawaan: 3
CCTV_PROCESS_FPS=3
# Lebar kerja kamera pembaca label; QR butuh piksel cukup. Bawaan: 1280
CCTV_LABEL_WORK_MAX_WIDTH=1280
# Lebar kerja kamera lain. Bawaan: 640
CCTV_WORK_MAX_WIDTH=640
# Sub-stream (…02) untuk kamera tanpa pembacaan label.
#   auto (bawaan): sub-stream selama kamera itu tidak punya model deteksi paket.
#   true: selalu sub-stream. false: selalu main-stream (bukti foto/klip resolusi penuh).
CCTV_DETECT_USE_SUBSTREAM=auto
# Foto pantauan untuk dashboard: lebar maksimal dan interval kirim (detik). Bawaan: 640 dan 5
CCTV_OBSERVATION_MAX_WIDTH=640
CCTV_OBSERVATION_INTERVAL=5
# Batas antrian kerja per jenis; bila penuh, tugas terlama dibuang dan dicatat di log. Bawaan: 2, 8, 6
CCTV_OCR_QUEUE=2
CCTV_UPLOAD_QUEUE=8
CCTV_LIVE_QUEUE=6

# ---------------------------------------------------------------- Live di dashboard
# true (bawaan): encoder live hanya menyala saat ada yang menonton; mati sendiri setelah sepi.
CCTV_LIVE_ON_DEMAND=true
# Detik tanpa penonton sebelum encoder live dimatikan. Bawaan: 45
CCTV_LIVE_IDLE_SECONDS=45
# Panjang segmen HLS (detik). Lebih pendek = lebih realtime. Bawaan: 1
CCTV_LIVE_SEGMENT_SECONDS=1
# Live memakai sub-stream (ringan); main-stream hanya bila sub-stream tidak tersedia. Bawaan: true
CCTV_LIVE_USE_SUBSTREAM=true
# Hanya berlaku bila kamera mengirim H.265 dan perlu diubah ke H.264 untuk browser. Bawaan: 6 dan 960
CCTV_LIVE_FPS=6
CCTV_LIVE_MAX_WIDTH=960

# ---------------------------------------------------------------- Integrasi SLM
# Lewat Cloudflare (https). Bawaan: https://mkr.lrmslm.com
SLM_BASE_URL=https://mkr.lrmslm.com
SLM_LOOKUP_PATH=/api/cctv/labels/lookup
SLM_SYNC_PATH=/api/cctv/labels/sync
SLM_SYNC_UPLOAD_PHOTO=true
# Token yang sama dengan CCTV_API_TOKEN / CCTV_INTEGRATION_TOKEN di SLM.
SLM_API_TOKEN=
# Label yang cocok langsung ditandai selesai packing dan dikirim ke SLM. Bawaan: true
CCTV_AUTO_SYNC_PACKING=true

# ---------------------------------------------------------------- AI cadangan (opsional)
# Gemini dipakai hanya bila QR terlihat tetapi OpenCV gagal membacanya (silau/lecek).
CCTV_AI_PROVIDER=gemini
CCTV_AI_MODEL=gemini-3.5-flash-lite
CCTV_AI_API_KEY=

# ---------------------------------------------------------------- Notifikasi (opsional)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_TEMPLATE_NAME=
# Template resmi dengan header gambar dan tiga variabel teks pada body.
WA_IMAGE_TEMPLATE_NAME=

# ---------------------------------------------------------------- Container dan batas resource
# Port di host untuk nginx (cctv.lrmslm.com → 127.0.0.1:8095). Bawaan: 8095
CCTV_WEB_PORT=8095
# Pekerja artisan serve. Bawaan: 4
PHP_CLI_SERVER_WORKERS=4
# Batas memori PHP per proses. Bawaan: 128M
PHP_MEMORY_LIMIT=128M
# Batas RAM dan CPU per container. Terukur (3 kamera): web ±92 MB, worker ±98 MB, vision ±98 MB (±112 MB saat ketiga kamera ditonton live).
# Bawaan: web 256m/0.50, worker 192m/0.50, vision 192m/1.00
CCTV_WEB_MEM_LIMIT=256m
CCTV_WEB_CPUS=0.50
CCTV_WORKER_MEM_LIMIT=192m
CCTV_WORKER_CPUS=0.50
CCTV_VISION_MEM_LIMIT=192m
CCTV_VISION_CPUS=1.00
# Build arg image vision: 1 = pasang model deteksi (ultralytics/torch, image jauh lebih besar). Bawaan: 0
CCTV_WITH_MODEL=0
# Build arg image vision: 1 = pasang tesseract untuk CCTV_LABEL_MODE=auto. Bawaan: 0
CCTV_WITH_TESSERACT=0
# Model deteksi paket (opsional, butuh CCTV_WITH_MODEL=1) dan kamera yang memakainya (kosong = semua).
# CCTV_MODEL_PATH=/app/models/parcel.pt
# CCTV_MODEL_CAMERA_IDS=2
