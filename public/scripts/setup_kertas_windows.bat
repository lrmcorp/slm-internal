@echo off
:: =========================================================================
:: SLM - Setup Ukuran Kertas Continuous Form 12.0 x 14.0 cm (Epson LX-310 dsb.)
:: Windows 7/8/10/11. Klik kanan file ini, pilih "Run as administrator".
:: Isi PowerShell yang dijalankan sama dengan setup_kertas_windows.ps1 (dikodekan base64).
:: =========================================================================
title Setup Ukuran Kertas SLM 12x14
color 1F
echo =======================================================================
echo          SETUP UKURAN KERTAS CONTINUOUS FORM SLM (12 x 14 cm)
echo =======================================================================
echo.
net session >nul 2>&1
if %errorLevel% neq 0 (
    echo [PERHATIAN] Butuh hak Administrator.
    echo Klik kanan file ini, lalu pilih "Run as administrator".
    echo.
    pause
    exit /b 1
)
powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
if %errorLevel% neq 0 (
    echo.
    pause
    exit /b 1
)
echo.
echo =======================================================================
echo LANGKAH BERIKUTNYA:
echo 1. TUTUP SEMUA jendela Chrome/Edge (browser baru membaca ukuran kertas
echo    baru setelah dibuka ulang).
echo 2. Buka nota, tekan Cetak / Ctrl+P, pilih printer Epson LX-310.
echo 3. More settings - Paper size: pilih "SLM Continuous 12x14".
echo    Margins: None, Scale: 100, Headers and footers: tidak dicentang.
echo 4. Bila belum muncul: Settings - Printers - Epson LX-310 - Printing
echo    preferences - Advanced/Paper - pilih "SLM Continuous 12x14", OK,
echo    lalu buka ulang browser.
echo =======================================================================
echo.
pause
